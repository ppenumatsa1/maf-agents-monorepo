PORT=8000

# Service metadata
RA_SERVICE_NAME=researcher-agent
RA_SERVICE_VERSION=0.1.0
RA_LOG_LEVEL=INFO

# MAF provider settings
MAF_PROVIDER=foundry
MAF_MODEL=gpt-4o-mini

# Foundry Projects
FOUNDRY_PROJECTS_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=

# Azure Monitor / App Insights
APPLICATIONINSIGHTS_CONNECTION_STRING="connection_string"
OTEL_SERVICE_NAME="researcher-agent"
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=false

# Local smoke test base URL
SMOKE_BASE_URL=http://localhost:8000