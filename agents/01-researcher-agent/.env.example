# Service metadata
RA_SERVICE_NAME=researcher-agent
RA_SERVICE_VERSION=0.1.0
RA_LOG_LEVEL=INFO


# Foundry Projects (current project)
FOUNDRY_PROJECTS_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=

# Azure Monitor / App Insights
ENABLE_TELEMETRY=true
APPLICATIONINSIGHTS_CONNECTION_STRING="connection_string"
OTEL_SERVICE_NAME="researcher-agent"
OTEL_RECORD_CONTENT=true
ENABLE_INSTRUMENTATION=true
ENABLE_MANUAL_HTTP_INSTRUMENTATION=false

# Microsoft Entra ID authentication (set REQUIRE_AUTH=true in deployed environments)
REQUIRE_AUTH=false
ENTRA_AUTHORITY="https://login.microsoftonline.com"
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_API_APP_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_APP_ID="00000000-0000-0000-0000-000000000000"
ENTRA_API_AUDIENCE="api://00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_JWKS_CACHE_TTL_SECONDS=300
ENTRA_CLOCK_SKEW_SECONDS=60

# Local smoke test base URL
SMOKE_BASE_URL=http://localhost:8000
